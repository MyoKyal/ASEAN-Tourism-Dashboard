{
  "name": "asean-tourism-server",
  "version": "1.0.0",
  "description": "Express + MongoDB API for ASEAN Tourism Dashboard",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/scripts/seed.js",
    "export-seed-json": "node -e \"require('fs').writeFileSync('src/data/sites.seed.json', JSON.stringify(require('./src/data/sitesData').buildSites(), null, 2))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.6.0"
  }
}
